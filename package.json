{
  "name": "arduino-uno-studio",
  "version": "1.3.6",
  "private": true,
  "description": "A desktop Arduino Uno code editor, compiler, and simulator for young learners.",
  "author": "Arduino Uno Studio",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:renderer": "npm run autocomplete:generate && tsc -b && vite build",
    "build": "npm run build:renderer && electron-builder --win nsis",
    "pack": "npm run build:renderer && electron-builder --dir",
    "lint": "oxlint src electron scripts",
    "runtime:setup": "node scripts/setup-runtime.mjs",
    "runtime:test": "node scripts/test-runtime.mjs",
    "autocomplete:generate": "node scripts/generate-autocomplete.mjs",
    "autocomplete:test": "npm run autocomplete:generate && node --experimental-strip-types scripts/test-autocomplete.mjs",
    "diagnostics:test": "node --experimental-strip-types scripts/test-diagnostics.mjs",
    "code-fixer:test": "node --experimental-strip-types scripts/test-code-fixer.mjs",
    "toolbox:test": "node --experimental-strip-types scripts/test-toolbox.mjs",
    "examples:test": "node scripts/test-examples.mjs",
    "hardware:test": "node scripts/test-hardware.mjs",
    "circuit:test": "node --experimental-strip-types scripts/test-circuit.mjs",
    "electrical:test": "node --experimental-strip-types scripts/test-electrical.mjs",
    "ws2812:test": "node --experimental-strip-types scripts/test-ws2812.mjs",
    "ultrasonic:test": "node --experimental-strip-types scripts/test-ultrasonic.mjs",
    "sonar-api:test": "node --experimental-strip-types scripts/test-sonar-api.mjs",
    "simulator:test": "node --experimental-strip-types scripts/test-simulator.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@wokwi/elements": "^1.9.2",
    "avr8js": "0.21.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.arduino.unostudio",
    "productName": "Arduino Uno Studio",
    "artifactName": "Arduino-Uno-Studio-Setup-${version}-Windows-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "ARDUINO_EXAMPLES_LICENSE.txt",
      "CAPACITIVE_SENSOR_LICENSE.txt",
      "FASTLED_LICENSE.txt",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": ".runtime",
        "to": "runtime-template",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "perMachine": false
    }
  }
}
